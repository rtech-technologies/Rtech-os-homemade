# micro.rsl - The RSL Userland Text Editor

if sys_arg_1 == "" goto no_arg
let target_file = sys_arg_1
readfile buffer target_file
goto start_edit

:no_arg
let target_file = ""
let buffer = ""

:start_edit
cls
echo MICRO EDITOR v1.0
echo -------------------
echo_var buffer
echo
echo -------------------
echo ^X Exit (ESC)  ^O Write Out (CTRL+S not supported, use ESC prompt)

:wait_input
waitkey k
if k == "" goto wait_input

# Check if ESC was pressed (scancode -23)
if k == "-23" goto save

# Check if Backspace was pressed
if k == "-14" goto backspace
if k == "8" goto backspace
if k == "127" goto backspace

# Check if Enter was pressed
if k == "-28" goto enter
if k == "13" goto enter
if k == "10" goto enter

# Append character to buffer using our new str_append_str capability
# Since str_append takes an ascii code directly via variable lookup, we use str_append
str_append buffer k
goto start_edit

:enter
# ascii 10 is newline
let nl = "10"
str_append buffer nl
goto start_edit

:backspace
str_backspace buffer
goto start_edit

:save
cls
prompt_str save_path "Enter filename to save: "
if save_path == "" goto finish
writefile save_path buffer
echo File saved.

:finish
cls
echo Exiting micro...
