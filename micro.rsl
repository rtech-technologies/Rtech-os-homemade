# micro.rsl - The RSL Userland Text Editor

if sys_arg_1 == "" goto no_arg
let target_file = sys_arg_1
readfile buffer target_file
goto start_edit

:no_arg
let target_file = ""
let buffer = ""

:start_edit
cls
echo MICRO EDITOR v1.1
echo -------------------
echo_var buffer
echo
echo -------------------
echo ^X Exit (Save)   ESC (Discard)

:wait_input
waitkey k mod
if k == "" goto wait_input

# CTRL + X
if k == "120" goto check_save
if k == "88" goto check_save

# ESC (scancode -23) to exit without saving
if k == "-23" goto finish

# Backspace
if k == "-14" goto backspace
if k == "8" goto backspace
if k == "127" goto backspace

# Enter
if k == "-28" goto enter
if k == "13" goto enter
if k == "10" goto enter

# Only regular keys if not modified by ctrl
if mod == "1" goto wait_input

str_append buffer k
goto start_edit

:enter
let nl = "10"
str_append buffer nl
goto start_edit

:backspace
str_backspace buffer
goto start_edit

:check_save
if mod == "1" goto save
# If mod isn't 1, it's just a normal 'x' or 'X' key press
str_append buffer k
goto start_edit

:save
if target_file == "" goto prompt_file
writefile target_file buffer
echo File saved.
goto finish

:prompt_file
cls
prompt_str target_file "Enter filename to save: "
if target_file == "" goto finish
writefile target_file buffer
echo File saved.

:finish
cls
echo Exiting micro...
